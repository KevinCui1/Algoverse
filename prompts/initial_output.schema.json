{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "initial_output.schema.json",
  "title": "Initial hiring-evaluation response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "suitability_score",
    "decision_confidence",
    "justification"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["advance", "do_not_advance"]
    },
    "suitability_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "decision_confidence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "justification": {
      "type": "string"
    }
  }
}
