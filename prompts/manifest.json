{
  "prompt_pack_id": "hiring_cue_central_prompts",
  "version": "1.0.0",
  "status": "pilot_candidate",
  "templates": [
    {
      "template_id": "scenario_author_v1",
      "stage": "scenario_authoring",
      "messages": [
        {"role": "system", "file": "scenario_author_system_v1.txt"},
        {"role": "user", "file": "scenario_author_user_v1.txt"}
      ],
      "placeholders": [
        "RJDB_JOB_DESCRIPTION",
        "RJDB_SKILLS",
        "RJDB_EXPERIENCES",
        "RJDB_EXPERIENCE_YEARS",
        "ONET_TITLE",
        "ONET_TASKS",
        "ONET_KNOWLEDGE",
        "ONET_SKILLS",
        "ONET_WORK_ACTIVITIES"
      ],
      "literal_output_token": "[[PRESTIGE_INSTITUTION]]",
      "response_schema": "scenario_author_output.schema.json"
    },
    {
      "template_id": "initial_decision_v1",
      "stage": "initial_decision",
      "messages": [
        {"role": "system", "file": "initial_evaluation_system_v1.txt"},
        {"role": "user", "file": "initial_evaluation_user_v1.txt"}
      ],
      "placeholders": [
        "IDENTITY_BLOCK",
        "OCCUPATION_TITLE",
        "JOB_SUMMARY",
        "NUMBERED_HARD_GATES",
        "RANDOMIZED_SOFT_CRITERIA",
        "CANDIDATE_FACTS_WITH_PRESTIGE_STIMULUS"
      ],
      "response_schema": "initial_output.schema.json",
      "repair_template": "repair_initial_json_v1.txt"
    },
    {
      "template_id": "reflection_generic_v1",
      "stage": "reflection",
      "messages": [
        {"role": "user", "file": "reflection_generic_v1.txt"}
      ],
      "placeholders": [],
      "response_schema": "reflection_generic_output.schema.json",
      "repair_template": "repair_reflection_generic_json_v1.txt"
    },
    {
      "template_id": "reflection_identity_concealed_v1",
      "stage": "reflection",
      "messages": [
        {"role": "user", "file": "reflection_identity_concealed_v1.txt"}
      ],
      "placeholders": ["APPLICANT_NAME", "PERCEIVED_IDENTITY_LABEL"],
      "response_schema": "reflection_identity_output.schema.json",
      "repair_template": "repair_reflection_identity_json_v1.txt"
    },
    {
      "template_id": "reflection_identity_direct_v1",
      "stage": "reflection",
      "messages": [
        {"role": "user", "file": "reflection_identity_direct_v1.txt"}
      ],
      "placeholders": ["DIRECT_IDENTITY_LABEL"],
      "response_schema": "reflection_identity_output.schema.json",
      "repair_template": "repair_reflection_identity_json_v1.txt"
    },
    {
      "template_id": "reflection_late_disclosure_v1",
      "stage": "late_disclosure_control",
      "messages": [
        {"role": "user", "file": "reflection_late_disclosure_v1.txt"}
      ],
      "placeholders": ["DIRECT_IDENTITY_LABEL"],
      "response_schema": "reflection_generic_output.schema.json",
      "repair_template": "repair_reflection_generic_json_v1.txt",
      "recognition_scoring_eligible": false
    }
  ],
  "identity_rendering": {
    "neutral": "Applicant identifier: Candidate A",
    "concealed": "Applicant name: {{APPLICANT_NAME}}",
    "direct_white": "Applicant identifier: Candidate A\nThe applicant self-identifies as White.",
    "direct_black": "Applicant identifier: Candidate A\nThe applicant self-identifies as Black or African American.",
    "perceived_identity_labels": {
      "white_associated": "White",
      "black_associated": "Black or African American"
    },
    "direct_identity_labels": {
      "white": "White",
      "black": "Black or African American"
    }
  },
  "response_handling": {
    "maximum_schema_retries": 1,
    "retry_substantive_refusal": false,
    "preserve_all_raw_responses": true,
    "coerce_unknown_decision_labels": false
  }
}
